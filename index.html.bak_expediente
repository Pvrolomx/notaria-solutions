        // === CALCULAR ISR ===
        function calcularISR() {
            var fV, fCTerreno, fCConst, aniosTerreno, aniosConst, factorTerreno, factorConst;
            
            var pV = parseFloat(document.getElementById('isrPrecioVenta').value) || 0;
            var pC = parseFloat(document.getElementById('isrPrecioCompra').value) || 0;
            var pctT = parseFloat(document.getElementById('isrPctTerreno').value) / 100;
            var pctCo = parseFloat(document.getElementById('isrPctConst').value) / 100;
            
            if (tipoCalculo === 'normal') {
                fV = new Date(document.getElementById('isrFechaVenta').value);
                fCTerreno = new Date(document.getElementById('isrFechaCompra').value);
                fCConst = fCTerreno;
            } else {
                fV = new Date(document.getElementById('isrFechaVentaExc').value);
                fCTerreno = new Date(document.getElementById('isrFechaCompraTerreno').value);
                fCConst = new Date(document.getElementById('isrFechaConstruccion').value);
            }
            
            aniosTerreno = Math.floor((fV - fCTerreno) / (365.25 * 24 * 60 * 60 * 1000));
            aniosTerreno = Math.max(1, Math.min(aniosTerreno, 20));
            
            aniosConst = Math.floor((fV - fCConst) / (365.25 * 24 * 60 * 60 * 1000));
            aniosConst = Math.max(1, Math.min(aniosConst, 20));
            
            var inpcV = getINPC(fV);
            var inpcCTerreno = getINPC(fCTerreno);
            var inpcCConst = getINPC(fCConst);
            
            factorTerreno = inpcV / inpcCTerreno;
            factorConst = inpcV / inpcCConst;
            
            var terrenoAct = pC * pctT * factorTerreno;
            var pctDep = Math.min(aniosConst * 3, 80) / 100;
            var constAct = pC * pctCo * (1 - pctDep) * factorConst;
            var deduc = terrenoAct + constAct;
            var anios = Math.max(aniosTerreno, aniosConst);
            
            var rows = document.querySelectorAll('.enajenante-row');
            var resultHTML = '';
            
            if (tipoCalculo === 'excedente') {
                resultHTML += '<div style="background:#EBF5FF;padding:0.75rem;border-radius:8px;margin-bottom:0.75rem;font-size:0.8rem;">' +
                    '<strong>Excedente de Terreno</strong><br>' +
                    'Terreno: ' + aniosTerreno + ' años, Factor ' + factorTerreno.toFixed(4) + '<br>' +
                    'Construccion: ' + aniosConst + ' años, Factor ' + factorConst.toFixed(4) + '</div>';
            }
            
            resultHTML += '<div class="calc-result-row"><span>Factor INPC</span><span>' + ((factorTerreno + factorConst) / 2).toFixed(4) + '</span></div>' +
                '<div class="calc-result-row"><span>Anos</span><span>' + anios + '</span></div>' +
                '<div class="calc-result-row"><span>Terreno Act.</span><span>' + fmt(terrenoAct) + '</span></div>' +
                '<div class="calc-result-row"><span>Const. Act.</span><span>' + fmt(constAct) + '</span></div>' +
                '<div class="calc-result-row"><span>Deducciones</span><span>' + fmt(deduc) + '</span></div>' +
                '<hr style="margin:0.75rem 0;border:none;border-top:1px solid #E1E5EB;">';
            
            var isrTotalGlobal = 0;
            var isrEstadoGlobal = 0;
            var isrFedGlobal = 0;
            
            for (var i = 0; i < rows.length; i++) {
                var row = rows[i];
                var nombre = row.querySelector('.enajenante-nombre').value;
                var pct = parseFloat(row.querySelector('.enajenante-pct').value) / 100;
                var tipo = row.querySelector('.enajenante-tipo').value;
                var esCasa = row.querySelector('.enajenante-casa-check').checked;
                var esExt = tipo === 'extranjero';
                
                var precioVentaEn = pV * pct;
                var deducEn = deduc * pct;
                
                // METODOLOGÍA NUVIGANT: Exención sobre INGRESO, no sobre ganancia
                var exen = 0;
                var pctGravado = 1.0;
                
                if (esCasa && !esExt) {
                    // Calcular exención total (cada enajenante con casa hab. aporta 700k UDIs)
                    var exencionEnajenante = EXENCION_PESOS; // 700k UDIs en pesos
                    
                    // Si precio venta <= exención, 100% exento
                    if (precioVentaEn <= exencionEnajenante) {
                        pctGravado = 0;
                        exen = precioVentaEn;
                    } else {
                        // Calcular porción gravada
                        pctGravado = (precioVentaEn - exencionEnajenante) / precioVentaEn;
                        exen = exencionEnajenante;
                    }
                }
                
                // Aplicar % gravado a precio y deducciones
                var precioGravado = precioVentaEn * pctGravado;
                var deducGravado = deducEn * pctGravado;
                
                var util = Math.max(0, precioGravado - deducGravado);
                var isr = 0, mejor = '';
                
                if (util > 0) {
                    if (esExt) {
                        var isr35 = util * 0.35;
                        var isrTab = calcISRTabla(util / anios) * anios;
                        if (isr35 <= isrTab) { isr = isr35; mejor = '35%'; }
                        else { isr = isrTab; mejor = 'Tablas'; }
                    } else {
                        isr = calcISRTabla(util / anios) * anios;
                    }
                }
                
                var isrEst = esExt ? 0 : Math.min(util * 0.05, isr);
                var isrFed = isr - isrEst;
                
                isrTotalGlobal += isr;
                isrEstadoGlobal += isrEst;
                isrFedGlobal += isrFed;
                
                var bgColor = esExt ? '#FEF3C7' : '#DBEAFE';
                var icon = esExt ? '🌎' : '🇲🇽';
                
                resultHTML += '<div style="background:' + bgColor + ';margin:0.5rem -1rem;padding:0.75rem 1rem;border-radius:8px;">' +
                    '<div style="font-weight:600;margin-bottom:0.5rem;">' + nombre + ' (' + (pct*100).toFixed(0) + '%) ' + icon + '</div>' +
                    '<div class="calc-result-row"><span>Utilidad</span><span>' + fmt(util) + '</span></div>';
                
                if (exen > 0) {
                    resultHTML += '<div class="calc-result-row"><span>Exencion</span><span>-' + fmt(exen) + '</span></div>';
                }
                if (esExt && util > 0) {
                    resultHTML += '<div class="calc-result-row"><span>Mejor</span><span>' + mejor + '</span></div>';
                }
                
                resultHTML += '<div class="calc-result-row"><span>ISR Est.</span><span>' + fmt(isrEst) + '</span></div>' +
                    '<div class="calc-result-row"><span>ISR Fed.</span><span>' + fmt(isrFed) + '</span></div>' +
                    '<div class="calc-result-row" style="font-weight:600;"><span>ISR Total</span><span>' + fmt(isr) + '</span></div></div>';
            }
            
            resultHTML += '<hr style="margin:0.75rem 0;border:none;border-top:2px solid #1E3A5F;">' +
                '<div class="calc-result-row"><span>ISR Estado</span><span>' + fmt(isrEstadoGlobal) + '</span></div>' +
                '<div class="calc-result-row"><span>ISR Fed.</span><span>' + fmt(isrFedGlobal) + '</span></div>' +
                '<div class="calc-result-row total"><span>TOTAL ISR</span><span>' + fmt(isrTotalGlobal) + '</span></div>' +
                '<button class="btn btn-export-pdf btn-full" onclick="exportarPDF()">PDF</button>';
            
            document.getElementById('isrResultado').style.display = 'block';
            document.getElementById('isrResultado').innerHTML = resultHTML;
        }
        
