                        var tcEl = document.getElementById('tcValor');
                        var udiEl = document.getElementById('udiValor');
                        var exEl = document.getElementById('exencionValor');
                        if (tcEl) tcEl.textContent = '$' + TC_USD.toFixed(2);
                        if (udiEl) udiEl.textContent = '$' + VALOR_UDI.toFixed(4);
                        if (exEl) exEl.textContent = '$' + (EXENCION_PESOS/1000000).toFixed(2) + 'M';
                    }
                })
                .catch(function(e) { console.log('TC fallback'); });
        }
        cargarTipoCambio();

        
