            document.getElementById('resIVA').textContent = '$' + iva.toLocaleString('es-MX', {minimumFractionDigits: 2});
            document.getElementById('resTotal').textContent = '$' + total.toLocaleString('es-MX', {minimumFractionDigits: 2});
        }
        
        // === DATOS ISR ===
        var INPC = {
            '2015': 87.5, '2016': 90.4, '2017': 94.5, '2018': 98.0, '2019': 101.5,
            '2020': 104.5, '2021': 109.5, '2022': 117.5, '2023': 124.0, '2024': 131.0, '2025': 141.0
        };
        
        var INPC_MENSUAL = {};
        var INPC_CARGADO = false;
        
        // Cargar INPC desde API al inicio
        function cargarINPC() {
            fetch('/api/inpc')
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (data.anual) {
                        INPC = data.anual;
                        INPC_CARGADO = true;
                        console.log('INPC cargado desde API:', data.fuente);
                    }
                    if (data.mensual) {
                        INPC_MENSUAL = data.mensual;
                    }
                })
                .catch(function(err) {
                    console.log('Usando INPC hardcodeado (fallback)');
                });
        }
        
        // Obtener INPC por fecha (intenta mensual primero, luego anual)
        function getINPC(fecha) {
            var d = new Date(fecha);
            var year = d.getFullYear();
            var month = String(d.getMonth() + 1).padStart(2, '0');
            var key = year + '-' + month;
            
            // Intentar mensual primero
            if (INPC_MENSUAL[key]) {
                return INPC_MENSUAL[key];
            }
            // Fallback a anual
            return INPC[year] || 141;
        }
        
        // Cargar al inicio
        document.addEventListener('DOMContentLoaded', cargarINPC);
        
        var TABLAS_ISR = [
            { lim: 0, cuota: 0, tasa: 1.92 },
            { lim: 8952.50, cuota: 171.88, tasa: 6.40 },
            { lim: 75984.56, cuota: 4461.94, tasa: 10.88 },
            { lim: 133536.08, cuota: 10723.55, tasa: 16.00 },
            { lim: 155229.81, cuota: 14194.54, tasa: 17.92 },
            { lim: 185852.58, cuota: 19682.13, tasa: 21.36 },
            { lim: 374837.89, cuota: 60049.40, tasa: 23.52 },
            { lim: 590796.00, cuota: 110842.74, tasa: 30.00 },
            { lim: 1127926.85, cuota: 271981.99, tasa: 32.00 },
            { lim: 1503902.47, cuota: 392294.17, tasa: 34.00 },
            { lim: 4511707.38, cuota: 1414947.85, tasa: 35.00 }
        ];
        
        function fmt(n) { 
            return '$' + n.toLocaleString('es-MX', {minimumFractionDigits:2, maximumFractionDigits:2}); 
        }
        
        function calcISRTabla(util) {
            if (util <= 0) return 0;
            for (var i = TABLAS_ISR.length - 1; i >= 0; i--) {
                if (util >= TABLAS_ISR[i].lim) {
                    return TABLAS_ISR[i].cuota + ((util - TABLAS_ISR[i].lim) * TABLAS_ISR[i].tasa / 100);
                }
            }
            return 0;
        }
        
        // === TIPO CALCULO ISR ===
        var tipoCalculo = 'normal';
