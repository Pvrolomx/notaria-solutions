        function renderCitas() {
            var citas = getCitas();
            var container = document.getElementById('listaCitas');
            var totalEl = document.getElementById('totalCitas');
            var hoyEl = document.getElementById('citasHoy');
            var semanaEl = document.getElementById('citasSemana');
            
            if (totalEl) totalEl.textContent = citas.length;
            
            var hoy = new Date().toISOString().split('T')[0];
            var inicioSemana = new Date();
            inicioSemana.setDate(inicioSemana.getDate() - inicioSemana.getDay());
            var finSemana = new Date(inicioSemana);
            finSemana.setDate(finSemana.getDate() + 6);
            
            var countHoy = 0, countSemana = 0;
            for (var i = 0; i < citas.length; i++) {
                var fechaCita = citas[i].fecha;
                if (fechaCita === hoy) countHoy++;
                if (fechaCita >= inicioSemana.toISOString().split('T')[0] && 
                    fechaCita <= finSemana.toISOString().split('T')[0]) countSemana++;
            }
            if (hoyEl) hoyEl.textContent = countHoy;
            if (semanaEl) semanaEl.textContent = countSemana;
            
            if (!container) return;
            if (citas.length === 0) {
                container.innerHTML = '<p style="text-align:center;padding:2rem;color:var(--text-light);">No hay citas. Agenda una nueva.</p>';
                return;
            }
            
            // Ordenar por fecha y hora
            citas.sort(function(a, b) {
                var dateA = a.fecha + 'T' + (a.hora || '00:00');
                var dateB = b.fecha + 'T' + (b.hora || '00:00');
                return dateA.localeCompare(dateB);
            });
            
            var html = '';
            for (var i = 0; i < citas.length; i++) {
                var c = citas[i];
                var badgeClass = 'pending';
                if (c.estado === 'Confirmada') badgeClass = 'progress';
                if (c.estado === 'Completada') badgeClass = 'success';
                if (c.estado === 'Cancelada') badgeClass = 'urgent';
                
                var fechaStr = c.fecha ? new Date(c.fecha + 'T12:00:00').toLocaleDateString('es-MX', {weekday:'short', day:'numeric', month:'short'}) : '';
                var horaStr = c.hora || '';
                
                html += '<div class="list-item" onclick="verCita(' + i + ')" style="cursor:pointer;">' +
                    '<div class="list-item-avatar">📅</div>' +
                    '<div class="list-item-info">' +
                    '<h4>' + horaStr + ' - ' + (c.clienteNombre || c.titulo) + '</h4>' +
                    '<p>' + c.tipo + ' • ' + fechaStr + '</p>' +
                    '</div>' +
                    '<span class="status-badge ' + badgeClass + '">' + c.estado + '</span>' +
                    '</div>';
            }
            container.innerHTML = html;
        }
        
