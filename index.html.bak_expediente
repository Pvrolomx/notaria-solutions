<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <meta name="theme-color" content="#d4af37">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="NotariaSol">
    <title>Notarial Solutions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #1E3A5F;
            --primary-light: #2D5A8B;
            --accent: #C9A227;
            --bg: #F5F7FA;
            --white: #FFFFFF;
            --text: #333333;
            --text-light: #666666;
            --border: #E1E5EB;
            --success: #22C55E;
            --warning: #F59E0B;
            --danger: #EF4444;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }
        
        /* Header Mobile-First */
        .app-header {
            background: var(--white);
            padding: 1.5rem;
            text-align: center;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .app-logo {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
        }
        .app-logo-img {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            object-fit: cover;
        }
        .app-logo-icon {
            width: 48px;
            height: 48px;
            background: var(--accent);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }
        .app-logo-text h1 {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary);
        }
        .app-logo-text p {
            font-size: 0.7rem;
            color: var(--text-light);
        }
        .user-bar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin-top: 0.75rem;
            font-size: 0.75rem;
            color: var(--text-light);
        }
        .user-bar button {
            background: none;
            border: none;
            color: var(--danger);
            cursor: pointer;
            font-size: 0.75rem;
        }
        
        /* Main Container */
        .app-main {
            max-width: 500px;
            margin: 0 auto;
            padding: 1.5rem;
        }
        
        /* Main Menu Grid - 4 botones grandes */
        .main-menu {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .menu-btn {
            background: var(--white);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.08);
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
        }
        .menu-btn:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }
        .menu-btn:active {
            transform: scale(0.98);
        }
        .menu-btn-icon {
            height: 120px;
            overflow: hidden;
            border-radius: 16px 16px 0 0;
        }
        .menu-btn-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .menu-btn-content {
            padding: 1rem;
        }
        .menu-btn-content h3 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--text);
            margin-bottom: 0.25rem;
        }
        .menu-btn-content p {
            font-size: 0.7rem;
            color: var(--text-light);
        }
        .menu-btn-badge {
            display: inline-block;
            background: var(--accent);
            color: var(--primary);
            font-size: 0.65rem;
            font-weight: 600;
            padding: 0.2rem 0.5rem;
            border-radius: 10px;
            margin-left: 0.5rem;
        }
        
        /* Secondary Menu - Chat y Llamadas */
        .secondary-menu {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
        .secondary-btn {
            background: var(--white);
            border-radius: 12px;
            padding: 1rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .secondary-btn:hover {
            border-color: var(--primary);
            box-shadow: 0 4px 12px rgba(30, 58, 95, 0.1);
        }
        .secondary-btn-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
        .secondary-btn-icon.chat { background: #DBEAFE; }
        .secondary-btn-icon.llamadas { background: #D1FAE5; }
        .secondary-btn-text h4 { font-size: 0.85rem; font-weight: 500; }
        .secondary-btn-text p { font-size: 0.65rem; color: var(--text-light); }
        .secondary-btn-badge {
            margin-left: auto;
            background: var(--danger);
            color: white;
            font-size: 0.6rem;
            font-weight: 600;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Panels */
        .panel { display: none; }
        .panel.active { display: block; }
        
        .panel-header {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .back-btn {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.2rem;
            transition: all 0.2s;
        }
        .back-btn:hover {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }
        .panel-header h2 {
            font-size: 1.25rem;
            font-weight: 600;
        }
        .panel-header p {
            font-size: 0.8rem;
            color: var(--text-light);
        }
        
        /* Stats Cards */
        .stats-row {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }
        .stat-card {
            background: var(--white);
            border-radius: 12px;
            padding: 1rem;
            min-width: 120px;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .stat-card-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--primary);
        }
        .stat-card-label {
            font-size: 0.7rem;
            color: var(--text-light);
        }
        
        /* List Items */
        .list-container {
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .list-header {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .list-header h3 { font-size: 0.9rem; font-weight: 600; }
        .list-item {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .list-item:last-child { border-bottom: none; }
        .list-item-avatar {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }
        .list-item-info { flex: 1; }
        .list-item-info h4 { font-size: 0.9rem; font-weight: 500; }
        .list-item-info p { font-size: 0.75rem; color: var(--text-light); }
        
        /* Status Badge */
        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            padding: 0.25rem 0.6rem;
            border-radius: 20px;
            font-size: 0.65rem;
            font-weight: 500;
        }
        .status-badge.pending { background: #FEF3C7; color: #92400E; }
        .status-badge.progress { background: #DBEAFE; color: #1E40AF; }
        .status-badge.complete { background: #D1FAE5; color: #065F46; }
        .status-badge.urgent { background: #FEE2E2; color: #991B1B; }
        
        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.6rem 1rem;
            border-radius: 10px;
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            border: none;
        }
        .btn-primary { background: var(--primary); color: var(--white); }
        .btn-primary:hover { background: var(--primary-light); }
        .btn-outline { background: var(--white); border: 1px solid var(--border); color: var(--text); }
        .btn-full { width: 100%; }
        
        /* Chat Panel */
        .chat-container {
            background: var(--white);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            height: calc(100vh - 250px);
            display: flex;
            flex-direction: column;
        }
        .chat-header {
            padding: 1rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .chat-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }
        .chat-messages {
            flex: 1;
            padding: 1rem;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
        }
        .message {
            max-width: 80%;
            padding: 0.75rem 1rem;
            border-radius: 16px;
            font-size: 0.85rem;
        }
        .message.sent {
            background: var(--primary);
            color: white;
            align-self: flex-end;
            border-bottom-right-radius: 4px;
        }
        .message.received {
            background: var(--bg);
            align-self: flex-start;
            border-bottom-left-radius: 4px;
        }
        .chat-input {
            padding: 1rem;
            border-top: 1px solid var(--border);
            display: flex;
            gap: 0.75rem;
        }
        .chat-input input {
            flex: 1;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border);
            border-radius: 25px;
            font-size: 0.85rem;
            outline: none;
        }
        .chat-input button {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            border: none;
            cursor: pointer;
            font-size: 1.1rem;
        }
        
        /* Call Panel */
        .call-container {
            background: var(--white);
            border-radius: 16px;
            padding: 3rem 2rem;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .call-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: var(--primary);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: 600;
            margin: 0 auto 1.5rem;
        }
        .call-name { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }
        .call-status { color: var(--text-light); margin-bottom: 2rem; font-size: 0.85rem; }
        .call-actions { display: flex; justify-content: center; gap: 1.5rem; }
        .call-btn {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            font-size: 1.3rem;
            transition: all 0.2s;
        }
        .call-btn.mute { background: var(--bg); }
        .call-btn.video { background: var(--bg); }
        .call-btn.call { background: var(--success); color: white; }
        .call-btn.end { background: var(--danger); color: white; }
        
        /* Calculadora */
        .calc-card {
            background: var(--white);
            border-radius: 16px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }
        .calc-card h3 { font-size: 0.95rem; font-weight: 600; margin-bottom: 1rem; }
        .calc-field { margin-bottom: 1rem; }
        .calc-field label { display: block; font-size: 0.75rem; color: var(--text-light); margin-bottom: 0.4rem; }
        .calc-field input, .calc-field select {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 0.9rem;
            outline: none;
        }
        .calc-result { background: var(--bg); padding: 1rem; border-radius: 10px; margin-top: 1rem; }
        .calc-result-row { display: flex; justify-content: space-between; padding: 0.4rem 0; font-size: 0.85rem; }
        .calc-result-row.total { border-top: 1px solid var(--border); margin-top: 0.5rem; padding-top: 0.75rem; font-weight: 600; }
        
        /* Quick Actions */
        .quick-actions {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }
        .quick-action {
            background: var(--white);
            border-radius: 12px;
            padding: 1rem;
            min-width: 100px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            cursor: pointer;
            flex-shrink: 0;
        }
        .quick-action-icon { font-size: 1.5rem; margin-bottom: 0.5rem; }
        .quick-action-text { font-size: 0.7rem; color: var(--text-light); }
    
        /* Calculadoras Menu */
        .calc-menu-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .calc-menu-btn {
            background: var(--white);
            border-radius: 16px;
            padding: 1.25rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            border: 1px solid var(--border);
        }
        .calc-menu-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            border-color: var(--primary);
        }
        .calc-menu-icon {
            width: 50px;
            height: 50px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
        }
        .calc-menu-icon.isr { background: linear-gradient(135deg, #7C3AED 0%, #A78BFA 100%); }
        .calc-menu-icon.istp { background: linear-gradient(135deg, #059669 0%, #34D399 100%); }
        .calc-menu-icon.iva { background: linear-gradient(135deg, #D97706 0%, #FBBF24 100%); }
        .calc-menu-text h4 { font-size: 1rem; font-weight: 600; }
        .calc-menu-text p { font-size: 0.75rem; color: var(--text-light); }
        .calc-panel { margin-top: 1rem; }
        .calc-back {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.6rem 1rem;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.85rem;
            margin-bottom: 1rem;
        }
        .calc-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0.75rem;
            margin-bottom: 0.75rem;
        }
        .calc-checks {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1rem;
            font-size: 0.85rem;
        }
        .calc-checks label {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        /* Enajenantes */
        
        /* PDF Export */
        .btn-export-pdf {
            background: var(--accent);
            color: var(--primary);
            margin-top: 1rem;
        }
        .btn-export-pdf:hover {
            background: #B8911F;
        }
        .pdf-header {
            text-align: center;
            padding: 1rem;
            border-bottom: 2px solid var(--primary);
            margin-bottom: 1rem;
        }
        .pdf-header h2 {
            color: var(--primary);
            font-size: 1.25rem;
        }
        .pdf-header p {
            font-size: 0.8rem;
            color: var(--text-light);
        }
        .pdf-footer {
            text-align: center;
            padding: 1rem;
            border-top: 1px solid var(--border);
            margin-top: 1rem;
            font-size: 0.7rem;
            color: var(--text-light);
        }
        @media print {
            .calc-back, .btn-export-pdf, .btn-primary { display: none !important; }
        }

        
        /* Calc Tabs */
        
        /* Guardar en Expediente */
        .expediente-selector {
            background: var(--bg);
            border-radius: 12px;
            padding: 1rem;
            margin-top: 1rem;
            border: 1px dashed var(--border);
        }
        .expediente-selector h4 {
            font-size: 0.85rem;
            margin-bottom: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .expediente-selector select {
            width: 100%;
            padding: 0.6rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.85rem;
            margin-bottom: 0.75rem;
        }
        .expediente-nuevo {
            display: flex;
            gap: 0.5rem;
        }
        .expediente-nuevo input {
            flex: 1;
            padding: 0.6rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.85rem;
        }
        .btn-guardar-exp {
            background: var(--success);
            color: white;
        }
        .btn-guardar-exp:hover {
            background: #1DAA54;
        }
        .guardado-ok {
            background: #D1FAE5;
            color: #065F46;
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 0.85rem;
            margin-top: 0.75rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .expedientes-guardados {
            margin-top: 0.5rem;
            font-size: 0.75rem;
            color: var(--text-light);
        }

        .calc-tabs {
            display: flex;
            gap: 0.5rem;
            margin-bottom: 1rem;
        }
        .calc-tab {
            flex: 1;
            padding: 0.6rem 1rem;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--bg);
            cursor: pointer;
            font-size: 0.8rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .calc-tab.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }
        .calc-tab:hover:not(.active) {
            border-color: var(--primary);
        }
        .info-excedente {
            background: #EBF5FF;
            border-left: 3px solid var(--primary);
            padding: 0.75rem;
            border-radius: 0 8px 8px 0;
            font-size: 0.75rem;
            margin-bottom: 1rem;
            color: var(--text-light);
        }

        .enajenantes-section {
            background: var(--bg);
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        .enajenantes-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.75rem;
        }
        .enajenantes-header label {
            font-size: 0.85rem;
            font-weight: 600;
        }
        .btn-add-enajenante {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.4rem 0.75rem;
            border-radius: 6px;
            font-size: 0.75rem;
            cursor: pointer;
        }
        .enajenante-row {
            display: grid;
            grid-template-columns: 1fr 60px 100px auto auto;
            gap: 0.5rem;
            align-items: center;
            margin-bottom: 0.5rem;
            padding: 0.5rem;
            background: var(--white);
            border-radius: 8px;
        }
        .enajenante-row input, .enajenante-row select {
            padding: 0.5rem;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 0.8rem;
        }
        .enajenante-nombre { min-width: 0; }
        .enajenante-pct { width: 60px; text-align: center; }
        .enajenante-tipo { width: 100px; }
        .enajenante-casa { font-size: 0.7rem; white-space: nowrap; display: flex; align-items: center; gap: 0.25rem; }
        .enajenante-casa input { width: 14px; height: 14px; }
        .btn-remove-enajenante {
            background: var(--danger);
            color: white;
            border: none;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 0.8rem;
        }
        .enajenantes-total {
            text-align: right;
            font-size: 0.8rem;
            font-weight: 600;
            margin-top: 0.5rem;
            padding-top: 0.5rem;
            border-top: 1px solid var(--border);
        }
        @media (max-width: 500px) {
            .enajenante-row {
                grid-template-columns: 1fr 50px;
                gap: 0.4rem;
            }
            .enajenante-tipo, .enajenante-casa, .btn-remove-enajenante {
                grid-column: span 1;
            }
        }

        .calc-checks input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: var(--primary);
        }

    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
</head>
<body>
    <header class="app-header">
