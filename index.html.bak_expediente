        // === HONORARIOS ===
        function calcularHonorarios() {
            var valor = parseFloat(document.getElementById('calcValor').value) || 0;
            var tipo = document.getElementById('calcTipo').value;
            var honorarios = tipo === 'poder' ? 3500 : tipo === 'testamento' ? 5000 : Math.max(valor * 0.005, 5000);
            var iva = honorarios * 0.16;
